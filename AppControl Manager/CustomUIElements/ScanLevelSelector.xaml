<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AppControlManager.CustomUIElements.ScanLevelSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:intelgathering="using:CommonCore.IntelGathering">

    <UserControl.Resources>
        <DataTemplate x:Key="SelectedFallbackTemplate" x:DataType="intelgathering:FallbackItem">
            <StackPanel Margin="0,2,6,2"
                        Orientation="Horizontal"
                        Spacing="5">
                <Border Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2">
                    <TextBlock Text="{x:Bind Name}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <FontIcon Glyph="&#xE76C;"
                          FontSize="8"
                          Visibility="{x:Bind ChevronVisibility}"
                          VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EditableFallbackTemplate" x:DataType="intelgathering:FallbackItem">
            <StackPanel Margin="0,2,6,2"
                        Orientation="Horizontal"
                        Spacing="5">
                <Border Tag="{x:Bind}"
                        IsHitTestVisible="{x:Bind CanEdit}"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        PointerEntered="FallbackChip_PointerEntered"
                        PointerExited="FallbackChip_PointerExited"
                        Tapped="FallbackChip_Tapped">
                    <TextBlock Text="{x:Bind Name}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Tag="{x:Bind}"
                                        Click="MoveFallbackLeft_Click"
                                        ToolTipService.ToolTip="Move left">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                                <Button Tag="{x:Bind}"
                                        Click="MoveFallbackRight_Click"
                                        ToolTipService.ToolTip="Move right">
                                    <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                </Button>

                                <Button Tag="{x:Bind}"
                                        Click="RemoveFallback_Click"
                                        ToolTipService.ToolTip="Remove">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Border>
                <FontIcon Glyph="&#xE76C;"
                          FontSize="8"
                          Visibility="{x:Bind ChevronVisibility}"
                          VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SelectedFallbackRowTemplate" x:DataType="intelgathering:FallbackRow">
            <ItemsControl ItemsSource="{x:Bind Items}"
                          ItemTemplate="{StaticResource SelectedFallbackTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="EditableFallbackRowTemplate" x:DataType="intelgathering:FallbackRow">
            <ItemsControl ItemsSource="{x:Bind Items}"
                          ItemTemplate="{StaticResource EditableFallbackTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="SelectedScanLevelTemplate" x:DataType="intelgathering:ScanLevelsComboBoxType">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{x:Bind FriendlyName}"
                               VerticalAlignment="Center" />
                    <RatingControl IsReadOnly="True"
                                   Value="{x:Bind Rating}"
                                   VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind EditableFallbackRows}"
                              ItemTemplate="{StaticResource SelectedFallbackRowTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EditableScanLevelTemplate" x:DataType="intelgathering:ScanLevelsComboBoxType">
            <Border Tag="{x:Bind}"
                    Margin="2,1"
                    Background="Transparent"
                    CornerRadius="4"
                    PointerEntered="Option_PointerEntered"
                    PointerExited="Option_PointerExited"
                    Tapped="Option_Tapped">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4,0,0,4"
                            Opacity="{x:Bind SelectionIndicatorOpacity, Mode=OneWay}" />

                    <StackPanel Grid.Column="1"
                                Margin="0,8,10,8"
                                Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{x:Bind FriendlyName}"
                                       VerticalAlignment="Center" />
                            <RatingControl IsReadOnly="True"
                                           Value="{x:Bind Rating}"
                                           VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{x:Bind EditableFallbackRows}"
                                          ItemTemplate="{StaticResource EditableFallbackRowTemplate}" />

                            <Button Tag="{x:Bind}"
                                    Width="24"
                                    Height="24"
                                    Margin="0,2,0,0"
                                    Padding="0"
                                    CornerRadius="12"
                                    VerticalAlignment="Top"
                                    Click="AddFallback_Click"
                                    ToolTipService.ToolTip="Add fallback">
                                <FontIcon Glyph="&#xE710;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ComboBox IsHitTestVisible="False"
                  ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                  SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
                  ItemTemplate="{StaticResource SelectedScanLevelTemplate}" />

        <Button Background="Transparent"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Button.Flyout>
                <Flyout x:Name="EditorFlyout" Placement="Bottom">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <!-- Keep the presenter's single scrollbar at the flyout edge. -->
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>

                    <ItemsControl ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                                  ItemTemplate="{StaticResource EditableScanLevelTemplate}" />
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
