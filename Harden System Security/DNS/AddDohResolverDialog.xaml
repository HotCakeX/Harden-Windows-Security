<customUI:ContentDialogV2
    x:Class="HardenSystemSecurity.DNS.AddDohResolverDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    x:Uid="DNSAddResolverContentDialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsValid, Mode=OneWay}"
    FlowDirection="{x:Bind AppSettings.ApplicationGlobalFlowDirection, Mode=OneWay}">

    <StackPanel Spacing="12"
                MinWidth="460"
                Padding="4">

        <TextBlock x:Uid="DNSAddResolverContentDialogSubTitle"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- The Add button is enabled once every field is filled in and the address is an HTTPS URL -->
        <TextBox x:Uid="DNSCustomResolverCompanyTextBox"
                 Text="{x:Bind Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox PlaceholderText="https://resolver.example/dns-query"
                 Text="{x:Bind ResolverUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox x:Uid="DNSCustomResolverDescriptionTextBox"
                 Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

    </StackPanel>

</customUI:ContentDialogV2>
