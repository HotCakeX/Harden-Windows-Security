<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<Version>$(FileVersion)</Version>
		<FileVersion>1.0.0.0</FileVersion>
		<AssemblyVersion>$(FileVersion)</AssemblyVersion>
		<Title>Harden System Security Global Search</Title>
		<Copyright>Violet Hansen</Copyright>
		<Description>Global Search Service for the Harden System Security App</Description>
		<StartupObject>GlobalSearchService.SearchServiceHost</StartupObject>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
        <OptimizationPreference>Speed</OptimizationPreference>
		<PublishAot>True</PublishAot>
		<PublishTrimmed>True</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
		<ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<UseNativeHttpHandler>true</UseNativeHttpHandler>
		<MetricsSupport>false</MetricsSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<Http3Support>false</Http3Support>
		<!-- https://learn.microsoft.com/dotnet/core/runtime-config/garbage-collector#background-gc -->
		<!-- https://learn.microsoft.com/en-us/dotnet/standard/garbage-collection/performance#workstation-or-server-garbage-collection -->
		<!-- Disables background GC, so the runtime does not create its dedicated background GC thread. -->
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<!-- https://learn.microsoft.com/dotnet/core/runtime-config/garbage-collector#conserve-memory -->
		<!-- 9 is the maximum: the GC keeps the heap as small as possible at the cost of more frequent full collections. -->
		<!-- Native AOT embeds RuntimeHostConfigurationOption items into the executable, so no runtimeconfig.json is needed. -->
		<RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
	</ItemGroup>

	<Import Project="..\CommonCore\CommonCore.projitems" Label="Shared" />
</Project>
