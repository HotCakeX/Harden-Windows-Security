<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HardenSystemSecurity.WindowComponents.QRCodeManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    xmlns:CC="using:CommonCore"
    Closed="{x:Bind OnClosed}">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid"
          Padding="15"
          RowSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="QR Code Manager"
                   Style="{ThemeResource TitleTextBlockStyle}"/>
        <SelectorBar x:Name="ModeSelector"
                     Grid.Row="1"
                     SelectionChanged="{x:Bind ModeSelector_SelectionChanged}">
            <SelectorBarItem x:Name="ReaderSelectorItem"
                             Text="Reader"
                             IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xED14;"/>
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="CreatorSelectorItem"
                             Text="Creator">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xF6A9;"/>
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>
        <customUI:InfoBarV2 Grid.Row="2"
                            IsOpen="{x:Bind MainInfoBar.IsOpen, Mode=TwoWay}"
                            Message="{x:Bind MainInfoBar.Message, Mode=OneWay}"
                            Title="{x:Bind MainInfoBar.Title, Mode=OneWay}"
                            Severity="{x:Bind MainInfoBar.Severity, Mode=OneWay}"
                            IsClosable="{x:Bind MainInfoBar.IsClosable, Mode=OneWay}"/>
        <Grid x:Name="ReaderView"
              Grid.Row="3"
              AllowDrop="{x:Bind CC:ViewModelBase.IsNotElevated}"
              DragOver="{x:Bind ReaderView_DragOver}"
              Drop="{x:Bind ReaderView_Drop}"
              RowSpacing="10">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="V"
                                     Modifiers="Control"
                                     Invoked="{x:Bind PasteReaderImagesAccelerator_Invoked}"/>
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Choose one or more images, select screen content, capture a region, or scan with the camera."
                       TextWrapping="WrapWholeWords"/>
            <CCToolKit:WrapPanel Grid.Row="1"
                                 HorizontalSpacing="8"
                                 Orientation="Horizontal"
                                 VerticalSpacing="8">
                <Button Content="Select image"
                        Click="{x:Bind SelectImage_Click}">
                    <Button.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C5;" FontSize="16"/>
                                <TextBlock Text="{x:Bind}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Select screen content"
                        Click="{x:Bind SelectScreenContent_Click}">
                    <Button.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="16"/>
                                <TextBlock Text="{x:Bind}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Use Snipping Tool"
                        Click="{x:Bind UseSnippingTool_Click}">
                    <Button.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xF7ED;" FontSize="16"/>
                                <TextBlock Text="{x:Bind}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Scan with camera"
                        Click="{x:Bind ScanWithCamera_Click}">
                    <Button.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE960;" FontSize="16"/>
                                <TextBlock Text="{x:Bind}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button x:Name="StopCameraButton"
                        Click="{x:Bind StopCamera_Click}"
                        Content="Stop camera"
                        IsEnabled="False">
                    <Button.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                                <TextBlock Text="{x:Bind}"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
            </CCToolKit:WrapPanel>
            <Grid Grid.Row="2">
                <Border x:Name="CameraPreviewBorder"
                        Background="Black"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="260"
                        SizeChanged="{x:Bind CameraPreviewBorder_SizeChanged}"
                        Visibility="Collapsed">
                    <Grid>
                        <MediaPlayerElement x:Name="CameraPreviewElement"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="True"
                                            Stretch="Uniform"/>
                        <Rectangle x:Name="CameraScanGuide"
                                   HorizontalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Opacity="0.75"
                                   RadiusX="6"
                                   RadiusY="6"
                                   Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                   StrokeDashArray="3,3"
                                   StrokeThickness="1"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border x:Name="DetectedQrBorder"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="260"
                        Padding="12"
                        Visibility="Collapsed">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Exact verified QR image used for decoding"/>
                        <Image x:Name="DetectedQrImage"
                               Grid.Row="1"
                               Stretch="Uniform"/>
                    </Grid>
                </Border>
            </Grid>
            <TextBox x:Name="DecodedTextBox"
                     Grid.Row="3"
                     AcceptsReturn="True"
                     IsReadOnly="True"                     
                     PlaceholderText="Decoded QR text appears here."
                     TextWrapping="Wrap"/>
            <Button x:Name="CopyButton"
                    Grid.Row="4"
                    Click="{x:Bind CopyButton_Click}"
                    Content="Copy decoded text"
                    HorizontalAlignment="Right"
                    IsEnabled="False">
                <Button.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                            <TextBlock Text="{x:Bind}"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
        </Grid>
        <Grid x:Name="CreatorView"
              Grid.Row="3"
              RowSpacing="10"
              Visibility="Collapsed">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="C"
                                     Modifiers="Control"
                                     Invoked="{x:Bind CopyCreatedQrAccelerator_Invoked}"/>
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"
                                 VerticalAlignment="Center"
                                 Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           Text="Error correction"/>
                <ComboBox x:Name="ErrorCorrectionComboBox"
                          SelectedIndex="1"
                          SelectionChanged="{x:Bind ErrorCorrectionComboBox_SelectionChanged}">
                    <ComboBoxItem Content="Low (L)"/>
                    <ComboBoxItem Content="Medium (M)"/>
                    <ComboBoxItem Content="Quartile (Q)"/>
                    <ComboBoxItem Content="High (H)"/>
                </ComboBox>
            </StackPanel>
            <TextBox x:Name="CreatorTextBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     MaxHeight="180"                     
                     PlaceholderText="Enter text or a URL"
                     TextChanged="{x:Bind CreatorTextBox_TextChanged}"
                     TextWrapping="Wrap"/>
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"                    
                    Padding="16">
                <Grid>
                    <Image x:Name="CreatedQrImage"
                           CanDrag="{x:Bind CC:ViewModelBase.IsNotElevated}"
                           DragStarting="{x:Bind CreatedQrImage_DragStarting}"
                           HorizontalAlignment="Center"
                           Stretch="Uniform"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="CreatorPlaceholder"
                               HorizontalAlignment="Center"
                               Text="The generated QR code appears here."
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <CCToolKit:WrapPanel Grid.Row="3"
                                 HorizontalSpacing="18"
                                 Orientation="Horizontal"
                                 VerticalSpacing="8">
                <StackPanel>
                    <TextBlock Opacity="0.7" Text="Version"/>
                    <TextBlock x:Name="CreatorVersionValue" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Opacity="0.7" Text="Matrix"/>
                    <TextBlock x:Name="CreatorDimensionsValue" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Opacity="0.7" Text="UTF-8 bytes"/>
                    <TextBlock x:Name="CreatorByteCountValue" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Opacity="0.7" Text="Error correction"/>
                    <TextBlock x:Name="CreatorErrorCorrectionValue" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Opacity="0.7" Text="Mask"/>
                    <TextBlock x:Name="CreatorMaskValue" Text="-"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Opacity="0.7" Text="Maximum capacity"/>
                    <TextBlock x:Name="CreatorRemainingCapacityValue" Text="-"/>
                </StackPanel>
            </CCToolKit:WrapPanel>
            <DropDownButton x:Name="DownloadQrButton"
                            Grid.Row="4"
                            Content="Save QR image"
                            HorizontalAlignment="Right"
                            IsEnabled="False">
                <DropDownButton.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA35;" FontSize="16"/>
                            <TextBlock Text="{x:Bind}"/>
                        </StackPanel>
                    </DataTemplate>
                </DropDownButton.ContentTemplate>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="{x:Bind SaveCreatedQr_Click}"
                                        Tag="0"
                                        Text="PNG image (.png)"/>
                        <MenuFlyoutItem Click="{x:Bind SaveCreatedQr_Click}"
                                        Tag="1"
                                        Text="Bitmap image (.bmp)"/>
                        <MenuFlyoutItem Click="{x:Bind SaveCreatedQr_Click}"
                                        Tag="2"
                                        Text="JPEG image (.jpg, .jpeg)"/>
                        <MenuFlyoutItem Click="{x:Bind SaveCreatedQr_Click}"
                                        Tag="3"
                                        Text="TIFF image (.tif, .tiff)"/>
                        <MenuFlyoutItem Click="{x:Bind SaveCreatedQr_Click}"
                                        Tag="4"
                                        Text="JPEG XR image (.jxr)"/>
                        <MenuFlyoutItem Click="{x:Bind SaveCreatedQr_Click}"
                                        Tag="5"
                                        Text="HEIF image (.heif, .heic)"/>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
    </Grid>
</Window>
