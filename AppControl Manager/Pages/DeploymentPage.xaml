<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppControlManager.Pages.DeploymentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    xmlns:CC="using:CommonCore"
    xmlns:animatedvisuals="using:AnimatedVisuals"
    xmlns:vm="using:AppControlManager.ViewModels"
    xmlns:appLocker="using:AppControlManager.AppLocker"
    FlowDirection="{x:Bind ViewModel.AppSettings.ApplicationGlobalFlowDirection, Mode=OneWay}">

    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <customUI:InfoBarV2 Grid.Row="0"
                                IsOpen="{x:Bind ViewModel.MainInfoBar.IsOpen, Mode=TwoWay}"
                                Message="{x:Bind ViewModel.MainInfoBar.Message, Mode=OneWay}"
                                Severity="{x:Bind ViewModel.MainInfoBar.Severity, Mode=OneWay}"
                                IsClosable="{x:Bind ViewModel.MainInfoBar.IsClosable, Mode=OneWay}">
                <customUI:InfoBarV2.Content>
                    <ProgressBar Margin="0,0,0,15"
                                 Visibility="{x:Bind ViewModel.MainProgressBarVisibility, Mode=OneWay}"
                                 Value="0"
                                 IsIndeterminate="True"
                                 Minimum="0"
                                 Maximum="100"/>
                </customUI:InfoBarV2.Content>
            </customUI:InfoBarV2>

            <StackPanel HorizontalAlignment="Stretch"
                        Spacing="{StaticResource SettingsCardSpacing}"
                        Grid.Row="1">

                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <Border BorderBrush="{x:Bind ViewModel.DeploymentHighlightBorderBrush, Mode=OneWay}"
                        BorderThickness="0.8"
                        CornerRadius="4">

                    <CCToolKit:SettingsExpander x:Uid="UseIntuneDeploySettingsExpander"
                                               IsExpanded="True">

                        <CCToolKit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{x:Bind ViewModel.DeploymentModeIcon, Mode=OneWay}"
                                      Foreground="{x:Bind ViewModel.DeploymentHeaderForeground, Mode=OneWay}" />
                        </CCToolKit:SettingsExpander.HeaderIcon>

                        <TextBlock Text="{x:Bind ViewModel.LocalOnlineStatusText, Mode=OneWay}"
                                   TextWrapping="Wrap" />

                        <CCToolKit:SettingsExpander.Items>

                            <customUI:SettingsCardV2 x:Uid="EntraSignInSettingsCard">

                                <customUI:SettingsCardV2.HeaderIcon>
                                    <FontIcon Glyph="&#xEC27;" />
                                </customUI:SettingsCardV2.HeaderIcon>

                                <customUI:GraphAuthPanel Host="{x:Bind ViewModel}"
                                                         x:Name="GraphAuthPanel" />

                            </customUI:SettingsCardV2>

                            <CCToolKit:SettingsCard x:Uid="SelectIntuneGroupsSettingsCard"
                                                   IsClickEnabled="True" IsActionIconVisible="True"
                                                   Click="{x:Bind ViewModel.SelectGroups_Click}">

                                <CCToolKit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE83B;" />
                                </CCToolKit:SettingsCard.HeaderIcon>

                                <!-- Selected Groups chip -->
                                <Border CornerRadius="8"
                                        Padding="10,6"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A9;"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock VerticalAlignment="Center">
                                                    <Run x:Uid="SelectedGroups" />
                                                    <Run Text="{x:Bind ViewModel.SelectedIntuneGroupsCount, Mode=OneWay}"
                                                         FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </CCToolKit:SettingsCard>

                        </CCToolKit:SettingsExpander.Items>
                    </CCToolKit:SettingsExpander>
                </Border>

                <CCToolKit:SettingsCard x:Uid="DeployUnsignedXMLPolicyFilesSettingsCard"
                                       IsClickEnabled="False"
                                       IsActionIconVisible="False"
                                       BorderBrush="{x:Bind ViewModel.DeploymentHighlightBorderBrush, Mode=OneWay}"
                                       BorderThickness="0.8">

                    <CCToolKit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE82D;" Foreground="{x:Bind ViewModel.DeploymentHeaderForeground, Mode=OneWay}" />
                    </CCToolKit:SettingsCard.HeaderIcon>

                    <CCToolKit:SettingsCard.Content>
                        <StackPanel>

                            <!-- Cloud Mode Indicator -->
                            <StackPanel Orientation="Horizontal"
                                         Spacing="8"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Right"
                                         Visibility="{x:Bind ViewModel.CloudModeIndicatorVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="DeepSkyBlue"/>
                                <TextBlock Text="Cloud Deployment" Foreground="DeepSkyBlue" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Local Mode Indicator -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.LocalModeIndicatorVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="Orange"/>
                                <TextBlock Text="Local Deployment" Foreground="Orange" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CCToolKit:WrapPanel HorizontalSpacing="15" VerticalSpacing="15">

                                <customUI:SplitButtonV3 x:Name="BrowseForXMLPolicyFilesButton"
                                                        PolicySelectionCommand="{x:Bind vm:ViewModelProvider.SidebarVM.SidebarPolicyConnect1Command, Mode=OneWay}"
                                                        ObservedData="{x:Bind ViewModel.FilesForUnsignedDeployment.Count, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                                        Click="{x:Bind ViewModel.BrowseForXMLPolicyFilesButton_Click}">
                                    <customUI:SplitButtonV3.Content>
                                        <CCToolKit:WrapPanel Orientation="Horizontal">

                                            <AnimatedIcon Visibility="{x:Bind ViewModel.UnsignedXMLFilesLightAnimatedIconVisibility, Mode=OneWay}"
                                                          Height="20"
                                                          Margin="0,0,5,0"
                                                          Width="20">
                                                <AnimatedIcon.Source>
                                                    <animatedvisuals:Light/>
                                                </AnimatedIcon.Source>
                                            </AnimatedIcon>

                                            <TextBlock x:Uid="BrowseTextBlock" />

                                        </CCToolKit:WrapPanel>
                                    </customUI:SplitButtonV3.Content>

                                    <customUI:SplitButtonV3.DetailsFlyout>
                                        <Flyout x:Name="BrowseForXMLPolicyFilesButton_Flyout">

                                            <CCToolKit:WrapPanel Orientation="Vertical" HorizontalSpacing="15" VerticalSpacing="15">

                                                <Button x:Uid="ClearButton"
                                                        Click="{x:Bind ViewModel.BrowseForXMLPolicyFilesButton_Flyout_Clear_Click}">
                                                    <Button.ContentTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE894;" FontSize="16"/>
                                                                <TextBlock Text="{x:Bind}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>

                                                <TextBlock x:Uid="ViewSelectedXMLFileTextBlock" TextWrapping="WrapWholeWords" />

                                                <customUI:ListBoxV2 MinWidth="400"
                                                         ItemsSource="{x:Bind ViewModel.FilesForUnsignedDeployment, Mode=OneWay}" />

                                            </CCToolKit:WrapPanel>

                                        </Flyout>
                                    </customUI:SplitButtonV3.DetailsFlyout>

                                </customUI:SplitButtonV3>

                                <Button HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.DeployUnsignedXMLButton_Click}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B6;" Margin="0,0,8,0" />
                                            <TextBlock x:Uid="DeployTextBlock"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                            </CCToolKit:WrapPanel>
                        </StackPanel>
                    </CCToolKit:SettingsCard.Content>

                </CCToolKit:SettingsCard>

                <Border BorderBrush="{x:Bind ViewModel.DeploymentHighlightBorderBrush, Mode=OneWay}"
                        BorderThickness="0.8"
                        CornerRadius="4">

                    <CCToolKit:SettingsExpander x:Uid="DeploySignedXMLPolicyFilesSettingsExpander"
                                               IsExpanded="True">

                        <CCToolKit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xEF3F;" Foreground="{x:Bind ViewModel.DeploymentHeaderForeground, Mode=OneWay}" />
                        </CCToolKit:SettingsExpander.HeaderIcon>

                        <StackPanel>
                            <!-- Cloud Mode Indicator -->
                            <StackPanel Orientation="Horizontal"
                                         Spacing="8"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Right"
                                         Visibility="{x:Bind ViewModel.CloudModeIndicatorVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="DeepSkyBlue"/>
                                <TextBlock Text="Cloud Deployment" Foreground="DeepSkyBlue" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Local Mode Indicator -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.LocalModeIndicatorVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="Orange"/>
                                <TextBlock Text="Local Deployment" Foreground="Orange" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CCToolKit:WrapPanel HorizontalSpacing="15" VerticalSpacing="15">

                                <customUI:SplitButtonV3 x:Name="BrowseForSignedXMLPolicyFilesButton"
                                                        PolicySelectionCommand="{x:Bind vm:ViewModelProvider.SidebarVM.SidebarPolicyConnect2Command, Mode=OneWay}"
                                                        IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                                        ObservedData="{x:Bind ViewModel.FilesForSignedDeployment.Count, Mode=OneWay}"
                                                        Click="{x:Bind ViewModel.BrowseForSignedXMLPolicyFilesButton_Click}">
                                    <customUI:SplitButtonV3.Content>
                                        <CCToolKit:WrapPanel Orientation="Horizontal">

                                            <AnimatedIcon Visibility="{x:Bind ViewModel.SignedXMLFilesLightAnimatedIconVisibility, Mode=OneWay}"
                                                          Height="20"
                                                          Margin="0,0,5,0"
                                                          Width="20">
                                                <AnimatedIcon.Source>
                                                    <animatedvisuals:Light/>
                                                </AnimatedIcon.Source>
                                            </AnimatedIcon>

                                            <TextBlock x:Uid="BrowseTextBlock" />

                                        </CCToolKit:WrapPanel>
                                    </customUI:SplitButtonV3.Content>

                                    <customUI:SplitButtonV3.DetailsFlyout>
                                        <Flyout x:Name="BrowseForSignedXMLPolicyFilesButton_Flyout">

                                            <CCToolKit:WrapPanel Orientation="Vertical" HorizontalSpacing="15" VerticalSpacing="15">

                                                <Button x:Uid="ClearButton"
                                                        Click="{x:Bind ViewModel.BrowseForSignedXMLPolicyFilesButton_Flyout_Clear_Click}">
                                                    <Button.ContentTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE894;" FontSize="16"/>
                                                                <TextBlock Text="{x:Bind}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>

                                                <TextBlock x:Uid="ViewSelectedXMLFileTextBlock" TextWrapping="WrapWholeWords" />

                                                <customUI:ListBoxV2 MinWidth="400"
                                                         ItemsSource="{x:Bind ViewModel.FilesForSignedDeployment, Mode=OneWay}" />

                                            </CCToolKit:WrapPanel>

                                        </Flyout>
                                    </customUI:SplitButtonV3.DetailsFlyout>

                                </customUI:SplitButtonV3>

                                <Button HorizontalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.DeploySignedXMLButtonIsEnabled, Mode=OneWay}"
                                        HorizontalContentAlignment="Center"
                                        Click="{x:Bind ViewModel.DeploySignedXMLButton_Click}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind ViewModel.DeploySignedXMLButtonFontIcon, Mode=OneWay}" Margin="0,0,8,0" />
                                            <TextBlock Text="{x:Bind ViewModel.DeploySignedXMLButtonContentTextBlock, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                            </CCToolKit:WrapPanel>
                        </StackPanel>

                        <CCToolKit:SettingsExpander.ItemsHeader>
                            <customUI:InfoBarV2 BorderThickness="0"
                                                CornerRadius="0"
                                                IsIconVisible="True"
                                                Message="Secure Boot is not enabled. Enable Secure Boot before relying on a signed policy for boot-chain protection."
                                                IsOpen="{x:Bind CC:KUSER_SHARED_DATA.IsSecureBootDisabled}"
                                                IsClosable="False"
                                                Severity="Warning"/>
                        </CCToolKit:SettingsExpander.ItemsHeader>

                        <CCToolKit:SettingsExpander.Items>

                            <customUI:SettingsCardV2 x:Uid="SignOnlyNoDeploySettingsCard"
                                                     IsClickEnabled="True"
                                                     IsActionIconVisible="False">

                                <customUI:SettingsCardV2.HeaderIcon>
                                    <FontIcon Glyph="&#xF572;" />
                                </customUI:SettingsCardV2.HeaderIcon>

                                <ToggleSwitch IsOn="{x:Bind ViewModel.SignOnlyNoDeployToggleSwitch, Mode=TwoWay}"
                                              x:Uid="ToggleSwitchGeneral"
                                              IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"/>

                            </customUI:SettingsCardV2>

                        </CCToolKit:SettingsExpander.Items>

                    </CCToolKit:SettingsExpander>
                </Border>


                <CCToolKit:SettingsCard x:Uid="DeployCIPFilesSettingsCard"
                                       IsClickEnabled="False"
                                       IsActionIconVisible="False"
                                       BorderBrush="{x:Bind ViewModel.DeploymentHighlightBorderBrush, Mode=OneWay}"
                                       BorderThickness="0.8">

                    <CCToolKit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEF3E;" Foreground="{x:Bind ViewModel.DeploymentHeaderForeground, Mode=OneWay}" />
                    </CCToolKit:SettingsCard.HeaderIcon>

                    <CCToolKit:SettingsCard.Content>
                        <StackPanel>
                            <!-- Cloud Mode Indicator -->
                            <StackPanel Orientation="Horizontal"
                                         Spacing="8"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Right"
                                         Visibility="{x:Bind ViewModel.CloudModeIndicatorVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="DeepSkyBlue"/>
                                <TextBlock Text="Cloud Deployment" Foreground="DeepSkyBlue" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Local Mode Indicator -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Right"
                                        Visibility="{x:Bind ViewModel.LocalModeIndicatorVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="Orange"/>
                                <TextBlock Text="Local Deployment" Foreground="Orange" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CCToolKit:WrapPanel HorizontalSpacing="15" VerticalSpacing="15">

                                <customUI:ButtonV2 x:Uid="FileBrowseButton"
                                                   ObservedData="{x:Bind ViewModel.CIPFiles.Count, Mode=OneWay}"
                                                   IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                                   Click="{x:Bind ViewModel.BrowseForCIPBinaryFilesButton_Click}">

                                    <customUI:ButtonV2.Flyout>
                                        <Flyout>

                                            <CCToolKit:WrapPanel Orientation="Vertical" HorizontalSpacing="15" VerticalSpacing="15">

                                                <Button x:Uid="ClearButton"
                                                        Click="{x:Bind ViewModel.BrowseForCIPBinaryFilesButton_Flyout_Clear_Click}">
                                                    <Button.ContentTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE894;" FontSize="16"/>
                                                                <TextBlock Text="{x:Bind}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>

                                                <TextBlock x:Uid="ViewSelectedCIPFilesTextBlock"
                                                           TextWrapping="WrapWholeWords" />

                                                <customUI:ListBoxV2 MinWidth="400"
                                                         ItemsSource="{x:Bind ViewModel.CIPFiles, Mode=OneWay}" />

                                            </CCToolKit:WrapPanel>

                                        </Flyout>
                                    </customUI:ButtonV2.Flyout>

                                </customUI:ButtonV2>

                                <Button HorizontalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                        HorizontalContentAlignment="Center"
                                        Click="{x:Bind ViewModel.DeployCIPButton_Click}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B6;" Margin="0,0,8,0" />
                                            <TextBlock x:Uid="DeployTextBlock"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                            </CCToolKit:WrapPanel>
                        </StackPanel>
                    </CCToolKit:SettingsCard.Content>

                </CCToolKit:SettingsCard>

                <CCToolKit:SettingsCard x:Uid="ConvertXMLToBinarySettingsCard"
                                       IsClickEnabled="False"
                                       IsActionIconVisible="False"
                                       BorderBrush="{x:Bind ViewModel.LocalOnlyBorderBrush, Mode=OneWay}"
                                       BorderThickness="0.8">

                    <CCToolKit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF003;" Foreground="{x:Bind ViewModel.LocalOnlyHeaderForeground, Mode=OneWay}" />
                    </CCToolKit:SettingsCard.HeaderIcon>

                    <CCToolKit:SettingsCard.Content>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Right">
                                <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="Orange"/>
                                <TextBlock Text="Local Feature" Foreground="Orange" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <CCToolKit:WrapPanel HorizontalSpacing="15" VerticalSpacing="15">

                                <customUI:ButtonV2 x:Uid="FileBrowseButton"
                                                   ObservedData="{x:Bind ViewModel.XMLFilesToConvertToCIP.Count, Mode=OneWay}"
                                                   IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                                   Click="{x:Bind ViewModel.BrowseForXMLPoliciesButton_Click}">

                                    <customUI:ButtonV2.Flyout>
                                        <Flyout>

                                            <CCToolKit:WrapPanel Orientation="Vertical" HorizontalSpacing="15" VerticalSpacing="15">

                                                <Button x:Uid="ClearButton"
                                                        Click="{x:Bind ViewModel.BrowseForXMLPoliciesButton_Flyout_Clear_Click}">
                                                    <Button.ContentTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE894;" FontSize="16"/>
                                                                <TextBlock Text="{x:Bind}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Button.ContentTemplate>
                                                </Button>

                                                <TextBlock x:Uid="ViewSelectedXMLFilesTextBlock"
                                                           TextWrapping="WrapWholeWords" />

                                                <customUI:ListBoxV2 MinWidth="400"
                                                         ItemsSource="{x:Bind ViewModel.XMLFilesToConvertToCIP, Mode=OneWay}" />

                                            </CCToolKit:WrapPanel>

                                        </Flyout>
                                    </customUI:ButtonV2.Flyout>

                                </customUI:ButtonV2>

                                <Button HorizontalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.AreElementsEnabled, Mode=OneWay}"
                                        HorizontalContentAlignment="Center"
                                        Click="{x:Bind ViewModel.ConvertXMLToCIPButton_Click}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B1;" Margin="0,0,8,0" />
                                            <TextBlock x:Uid="ConvertTextBlock"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                            </CCToolKit:WrapPanel>
                        </StackPanel>
                    </CCToolKit:SettingsCard.Content>

                </CCToolKit:SettingsCard>

                <!-- AppLocker Managed Installer -->
                <Border BorderBrush="{x:Bind ViewModel.DeploymentHighlightBorderBrush, Mode=OneWay}"
                        BorderThickness="0.8"
                        CornerRadius="4"
                        Margin="0,4,0,4">
                    <StackPanel Padding="10"
                                Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE72E;"
                                      FontSize="24"
                                      Foreground="{x:Bind ViewModel.DeploymentHeaderForeground, Mode=OneWay}"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Spacing="3">
                                <TextBlock Text="Managed Installers"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Create, apply, and review Managed Installer rules"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.AppLockerInfoBar.IsOpen, Mode=TwoWay}"
                                            Message="{x:Bind ViewModel.AppLockerInfoBar.Message, Mode=OneWay}"
                                            Severity="{x:Bind ViewModel.AppLockerInfoBar.Severity, Mode=OneWay}"
                                            IsClosable="{x:Bind ViewModel.AppLockerInfoBar.IsClosable, Mode=OneWay}"/>

                        <Border Padding="16"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorAltBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Add a Managed Installer"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Selected executable" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedManagedInstallerPath, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Click="{x:Bind ViewModel.BrowseForManagedInstallerExecutable_Click}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8E5;"/>
                                            <TextBlock Text="Select EXE"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="Rule name"
                                             Text="{x:Bind ViewModel.ManagedInstallerRuleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Column="1"
                                              Header="Rule type"
                                              SelectedIndex="{x:Bind ViewModel.ManagedInstallerSelectedRuleIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Path"
                                                      IsEnabled="{x:Bind ViewModel.ManagedInstallerPathRuleAvailable, Mode=OneWay}"/>
                                        <ComboBoxItem Content="Hash"
                                                      IsEnabled="{x:Bind ViewModel.ManagedInstallerHashRuleAvailable, Mode=OneWay}"/>
                                        <ComboBoxItem Content="Publisher"
                                                      IsEnabled="{x:Bind ViewModel.ManagedInstallerPublisherRuleAvailable, Mode=OneWay}"/>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Hash" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedManagedInstallerHash, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="Publisher" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedManagedInstallerPublisher, Mode=OneWay}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="Product" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedManagedInstallerProduct, Mode=OneWay}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Text="Binary" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedManagedInstallerBinary, Mode=OneWay}" TextWrapping="Wrap"/>
                                </Grid>
                                <Button HorizontalAlignment="Right"
                                        IsEnabled="{x:Bind ViewModel.CanApplyManagedInstaller, Mode=OneWay}"
                                        Click="{x:Bind ViewModel.ApplyManagedInstaller_Click}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;"/>
                                        <TextBlock Text="Apply Managed Installer"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12"
                              Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Current Policy"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.ManagedInstallerCountText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <DropDownButton Grid.Column="1"
                                            Content="Options">
                                <DropDownButton.ContentTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE712;" FontSize="16"/>
                                            <TextBlock Text="{x:Bind}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DropDownButton.ContentTemplate>
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Refresh"
                                                        Click="{x:Bind ViewModel.RefreshManagedInstallerPolicy}"
                                                        ToolTipService.ToolTip="Refresh the Managed Installer policy">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Clear Policy"
                                                        ToolTipService.ToolTip="Clear the entire AppLocker and Managed Installer policy"
                                                        Click="{x:Bind ViewModel.ClearManagedInstallerPolicy_Click}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.ManagedInstallerPolicy.Rules, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="420">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="appLocker:ManagedInstallerRuleInfo">
                                    <Border Padding="10"
                                            Margin="0,0,0,6"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}"
                                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                                           TextWrapping="Wrap"/>
                                                <Border Grid.Column="1"
                                                        Padding="8,4"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind RuleTypeText}"
                                                               FontSize="12"/>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Delete this Managed Installer"
                                                        VerticalAlignment="Center"
                                                        Click="{x:Bind vm:ViewModelProvider.DeploymentVM.DeleteManagedInstaller_Click}">
                                                    <FontIcon Glyph="&#xE74D;"/>
                                                </Button>
                                            </Grid>
                                            <StackPanel Height="{x:Bind PathSectionHeight}">
                                                <TextBlock Text="Path" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Height="{x:Bind HashSectionHeight}">
                                                <TextBlock Text="Authenticode hash" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind HashData}" FontFamily="Consolas" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind SourceFileName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Height="{x:Bind PublisherSectionHeight}"
                                                        Spacing="3">
                                                <TextBlock Text="Publisher" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind PublisherName}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind ProductName}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind BinaryName}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind VersionRange}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
