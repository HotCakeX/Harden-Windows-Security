{
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.6",
    "body": [
        {
            "type": "ColumnSet",
            "spacing": "none",
            "columns": [
                {
                    "type": "Column",
                    "width": "auto",
                    "spacing": "none",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "Image",
                            "$when": "${hasIcon}",
                            "spacing": "none",
                            "url": "${icon}",
                            "width": "${iconWidth}",
                            "altText": "${headline}"
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "spacing": "${countSpacing}",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "TextBlock",
                            "$when": "${countVisible}",
                            "spacing": "none",
                            "text": "${count}",
                            "size": "extraLarge",
                            "weight": "bolder",
                            "color": "${countColor}",
                            "wrap": false,
                            "maxLines": 1
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "stretch",
                    "spacing": "${headlineSpacing}",
                    "verticalContentAlignment": "center",
                    "items": [
                        {
                            "type": "TextBlock",
                            "spacing": "none",
                            "text": "${headline}",
                            "size": "${headlineSize}",
                            "weight": "bolder",
                            "wrap": true,
                            "maxLines": 2
                        },
                        {
                            "type": "TextBlock",
                            "$when": "${hasSubtitle}",
                            "spacing": "none",
                            "text": "${subtitle}",
                            "size": "small",
                            "weight": "lighter",
                            "isSubtle": true,
                            "wrap": true,
                            "maxLines": 2
                        }
                    ]
                }
            ]
        },
        {
            "type": "Container",
            "$when": "${hasPackages}",
            "spacing": "medium",
            "height": "stretch",
            "separator": true,
            "items": [
                {
                    "type": "Table",
                    "spacing": "none",
                    "firstRowAsHeaders": true,
                    "showGridLines": false,
                    "columns": [
                        {
                            "type": "TableColumnDefinition",
                            "width": 3,
                            "horizontalCellContentAlignment": "left",
                            "verticalCellContentAlignment": "center"
                        },
                        {
                            "type": "TableColumnDefinition",
                            "width": 2,
                            "horizontalCellContentAlignment": "right",
                            "verticalCellContentAlignment": "center"
                        },
                        {
                            "type": "TableColumnDefinition",
                            "width": 2,
                            "horizontalCellContentAlignment": "right",
                            "verticalCellContentAlignment": "center"
                        }
                    ],
                    "rows": [
                        {
                            "type": "TableRow",
                            "cells": [
                                {
                                    "type": "TableCell",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "spacing": "none",
                                            "text": "App",
                                            "size": "${textSize}",
                                            "weight": "bolder",
                                            "isSubtle": true,
                                            "wrap": false,
                                            "maxLines": 1
                                        }
                                    ]
                                },
                                {
                                    "type": "TableCell",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "spacing": "none",
                                            "text": "Current",
                                            "size": "${textSize}",
                                            "weight": "bolder",
                                            "isSubtle": true,
                                            "wrap": false,
                                            "maxLines": 1
                                        }
                                    ]
                                },
                                {
                                    "type": "TableCell",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "spacing": "none",
                                            "text": "New",
                                            "size": "${textSize}",
                                            "weight": "bolder",
                                            "isSubtle": true,
                                            "wrap": false,
                                            "maxLines": 1
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "TableRow",
                            "$data": "${packages}",
                            "cells": [
                                {
                                    "type": "TableCell",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "spacing": "none",
                                            "text": "${name}",
                                            "size": "${textSize}",
                                            "wrap": false,
                                            "maxLines": 1
                                        }
                                    ]
                                },
                                {
                                    "type": "TableCell",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "spacing": "none",
                                            "text": "${installedVersion}",
                                            "size": "${textSize}",
                                            "weight": "lighter",
                                            "isSubtle": true,
                                            "wrap": false,
                                            "maxLines": 1
                                        }
                                    ]
                                },
                                {
                                    "type": "TableCell",
                                    "items": [
                                        {
                                            "type": "TextBlock",
                                            "spacing": "none",
                                            "text": "${availableVersion}",
                                            "size": "${textSize}",
                                            "color": "accent",
                                            "wrap": false,
                                            "maxLines": 1
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "TextBlock",
                    "$when": "${hasMore}",
                    "spacing": "small",
                    "text": "${moreText}",
                    "size": "small",
                    "weight": "lighter",
                    "isSubtle": true,
                    "wrap": false,
                    "maxLines": 1
                }
            ]
        },
        {
            "type": "Container",
            "$when": "${hasMessage}",
            "spacing": "medium",
            "height": "stretch",
            "separator": true,
            "items": [
                {
                    "type": "TextBlock",
                    "spacing": "none",
                    "text": "${message}",
                    "size": "small",
                    "weight": "lighter",
                    "color": "attention",
                    "wrap": true,
                    "maxLines": 3
                }
            ]
        },
        {
            "type": "ColumnSet",
            "spacing": "default",
            "columns": [
                {
                    "type": "Column",
                    "width": "stretch",
                    "spacing": "none",
                    "items": [
                        {
                            "type": "ActionSet",
                            "spacing": "none",
                            "actions": [
                                {
                                    "type": "Action.Execute",
                                    "title": "${checkButtonTitle}",
                                    "verb": "checkForWinGetUpdates"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "width": "auto",
                    "spacing": "small",
                    "items": [
                        {
                            "type": "ActionSet",
                            "spacing": "none",
                            "actions": [
                                {
                                    "type": "Action.Execute",
                                    "title": "Open app",
                                    "verb": "openApp"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
