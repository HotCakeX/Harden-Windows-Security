<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HardenSystemSecurity.Pages.IntunePolicyDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CCGraph="using:CommonCore.MicrosoftGraph"
    xmlns:VMs="using:HardenSystemSecurity.ViewModels"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    KeyboardAcceleratorPlacementMode="Hidden"
    FlowDirection="{x:Bind ViewModel.AppSettings.ApplicationGlobalFlowDirection, Mode=OneWay}">

    <Page.Resources>
        <DataTemplate x:Key="ResponsiveAssignmentTemplate"
                      x:DataType="CCGraph:PolicyAssignmentDisplay">
            <Grid>
                <Grid x:Name="WideAssignmentLayout"
                      x:Load="{x:Bind VMs:ViewModelProvider.IntuneVM.IsPolicyDetailsWideLayout, Mode=OneWay}">
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        MinWidth="0">
                                <TextBlock Text="{x:Bind Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind TargetId}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Type}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind UserCount}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind DeviceCount}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <Button Grid.Column="4"
                                    Content="Remove"
                                    Tag="{x:Bind}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    IsEnabled="{x:Bind VMs:ViewModelProvider.IntuneVM.PolicyDetailsActionsEnabled, Mode=OneWay}"
                                    Click="{x:Bind VMs:ViewModelProvider.IntuneVM.RemovePolicyAssignment_Click}" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="CompactAssignmentLayout"
                      x:Load="{x:Bind VMs:ViewModelProvider.IntuneVM.IsPolicyDetailsCompactLayout, Mode=OneWay}">
                    <Border Margin="0,0,0,8"
                            Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0"
                                        MinWidth="0">
                                <TextBlock Text="{x:Bind Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{x:Bind TargetId}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Row="1"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Spacing="3">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon Glyph="&#xE8EC;"
                                                  FontSize="13" />
                                        <TextBlock Text="Type"
                                                   FontSize="12"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Type}"
                                               FontWeight="SemiBold"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Spacing="3">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon Glyph="&#xE716;"
                                                  FontSize="13" />
                                        <TextBlock Text="Users"
                                                   FontSize="12"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind UserCount}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="3">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon Glyph="&#xE770;"
                                                  FontSize="13" />
                                        <TextBlock Text="Managed devices"
                                                   FontSize="12"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind DeviceCount}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Button Grid.Row="2"
                                    HorizontalAlignment="Stretch"
                                    Tag="{x:Bind}"
                                    IsEnabled="{x:Bind VMs:ViewModelProvider.IntuneVM.PolicyDetailsActionsEnabled, Mode=OneWay}"
                                    Click="{x:Bind VMs:ViewModelProvider.IntuneVM.RemovePolicyAssignment_Click}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="7">
                                    <FontIcon Glyph="&#xE74D;"
                                              FontSize="14" />
                                    <TextBlock Text="Remove assignment" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5"
                             Invoked="{x:Bind RefreshKeyboardAccelerator_Invoked}" />
        <KeyboardAccelerator Key="Back"
                             Modifiers="None"
                             Invoked="{x:Bind BackKeyboardAccelerator_Invoked}" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="LayoutRoot"
          RowSpacing="12"
          SizeChanged="{x:Bind LayoutRoot_SizeChanged}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Style="{StaticResource TitleBarBackButtonStyle}"
                    ToolTipService.ToolTip="Back"
                    Click="{x:Bind BackButton_Click}" />

            <StackPanel Grid.Column="1"
                        Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.PolicyDetailsPolicy.Name, Mode=OneWay}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" />
                <TextBlock Text="{x:Bind ViewModel.PolicyDetailsPolicy.Description, Mode=OneWay}"
                           Opacity="0.75"
                           TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal"
                            Spacing="12">
                    <TextBlock>
                        <Run Text="Platform: " />
                        <Run Text="{x:Bind ViewModel.PolicyDetailsPolicy.Platforms, Mode=OneWay}"
                             FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Technologies: " />
                        <Run Text="{x:Bind ViewModel.PolicyDetailsPolicy.Technologies, Mode=OneWay}"
                             FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Settings: " />
                        <Run Text="{x:Bind ViewModel.PolicyDetailsPolicy.SettingCount, Mode=OneWay}"
                             FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <TextBlock FontSize="11"
                           Opacity="0.65">
                    <Run Text="Policy ID: " />
                    <Run Text="{x:Bind ViewModel.PolicyDetailsPolicy.Id, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <CCToolKit:WrapPanel Grid.Row="1"
                             Orientation="Horizontal"
                             HorizontalSpacing="10"
                             VerticalSpacing="10">
            <Button Content="Refresh"
                    IsEnabled="{x:Bind ViewModel.PolicyDetailsActionsEnabled, Mode=OneWay}"
                    Click="{x:Bind ViewModel.RefreshPolicyDetails_Click}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
                <Button.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            <TextBlock Text="{x:Bind}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <Button Content="Remove All Assignments"
                    IsEnabled="{x:Bind ViewModel.PolicyDetailsActionsEnabled, Mode=OneWay}"
                    Click="{x:Bind ViewModel.RemoveAllPolicyAssignments_Click}">
                <Button.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            <TextBlock Text="{x:Bind}" />
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>
            <DropDownButton Content="Add Assignment"
                            IsEnabled="{x:Bind ViewModel.PolicyDetailsActionsEnabled, Mode=OneWay}">
                <DropDownButton.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <TextBlock Text="{x:Bind}" />
                        </StackPanel>
                    </DataTemplate>
                </DropDownButton.ContentTemplate>
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="All Users"
                                        Click="{x:Bind ViewModel.AddAllUsersPolicyAssignment_Click}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE716;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="All Devices"
                                        Click="{x:Bind ViewModel.AddAllDevicesPolicyAssignment_Click}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE770;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <ProgressRing Width="24"
                          Height="24"
                          IsActive="{x:Bind ViewModel.PolicyDetailsIsLoading, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center">
                <Run Text="Assignment targets: " />
                <Run Text="{x:Bind ViewModel.PolicyDetailsAssignments.Count, Mode=OneWay}"
                     FontWeight="SemiBold" />
            </TextBlock>
        </CCToolKit:WrapPanel>

        <Grid Grid.Row="2">
            <Grid x:Name="WideAssignmentHeader"
                  x:Load="{x:Bind ViewModel.IsPolicyDetailsWideLayout, Mode=OneWay}"
                  Padding="12,8"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                    <TextBlock Text="Assignment target" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                    <TextBlock Text="Type" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                    <FontIcon Glyph="&#xE716;" FontSize="14" />
                    <TextBlock Text="Users" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                    <FontIcon Glyph="&#xE770;" FontSize="14" />
                    <TextBlock Text="Managed devices" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Action" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="CompactAssignmentHeader"
                        x:Load="{x:Bind ViewModel.IsPolicyDetailsCompactLayout, Mode=OneWay}"
                        Margin="12,8"
                        Orientation="Horizontal"
                        Spacing="7">
                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                <TextBlock Text="Assignment details" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <ListView x:Name="AssignmentsList"
                  Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.PolicyDetailsAssignments, Mode=OneWay}"
                  ItemTemplate="{StaticResource ResponsiveAssignmentTemplate}"
                  SelectionMode="None"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

        </ListView>
    </Grid>
</Page>
