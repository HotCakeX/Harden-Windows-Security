<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="HardenSystemSecurity.Pages.UpdatePageCustomMSIXPath"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:customUI="using:AppControlManager.CustomUIElements"
      xmlns:CCToolKit="using:CommonCore.ToolKits"
      xmlns:signing="using:CommonCore.Signing"
      FlowDirection="{x:Bind ViewModel.AppSettings.ApplicationGlobalFlowDirection, Mode=OneWay}">
    <ScrollViewer>
        <StackPanel HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">
            <StackPanel.ChildrenTransitions>
                <EntranceThemeTransition FromVerticalOffset="50" />
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </StackPanel.ChildrenTransitions>
            <!-- Package Installer -->
            <CCToolKit:SettingsExpander IsExpanded="True"
                                        Header="Package installation"
                                        Description="Install a selected package using the existing installation options."
                                        AutomationProperties.Name="Package installation"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
                <CCToolKit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </CCToolKit:SettingsExpander.HeaderIcon>
                <CCToolKit:SettingsExpander.Content>
                    <Button x:Uid="InstallAppPackagesButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="{x:Bind ViewModel.InstallButton_Click}"
                            IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
                        <Button.ContentTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE7B8;"
                                              FontSize="16" />
                                    <TextBlock Text="{x:Bind}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </CCToolKit:SettingsExpander.Content>
                <CCToolKit:SettingsExpander.ItemsHeader>
                    <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.AppPackageInstallerInfoBar.IsOpen, Mode=TwoWay}"
                                        Message="{x:Bind ViewModel.AppPackageInstallerInfoBar.Message, Mode=OneWay}"
                                        Severity="{x:Bind ViewModel.AppPackageInstallerInfoBar.Severity, Mode=OneWay}"
                                        IsIconVisible="True"
                                        IsClosable="{x:Bind ViewModel.AppPackageInstallerInfoBar.IsClosable, Mode=OneWay}" />
                </CCToolKit:SettingsExpander.ItemsHeader>
                <CCToolKit:SettingsExpander.Items>
                    <customUI:SettingsCardV3 x:Uid="BrowseForAppPackagePathSettingsCard">
                        <customUI:SettingsCardV3.HeaderIcon>
                            <FontIcon Glyph="&#xF83E;" />
                        </customUI:SettingsCardV3.HeaderIcon>
                        <customUI:ButtonV2 Click="{x:Bind ViewModel.BrowseForCustomMSIXPathButton_Click}"
                                           x:Uid="FileBrowseButton"
                                           IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                           Style="{StaticResource AccentButtonStyle}"
                                           ObservedData="{x:Bind ViewModel.LocalPackageFilePath, Mode=OneWay}">
                            <customUI:ButtonV2.ContentTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xEC50;"
                                                  FontSize="16" />
                                        <TextBlock Text="{x:Bind}" />
                                    </StackPanel>
                                </DataTemplate>
                            </customUI:ButtonV2.ContentTemplate>
                            <customUI:ButtonV2.Flyout>
                                <Flyout>
                                    <CCToolKit:WrapPanel Orientation="Vertical"
                                                         HorizontalSpacing="15"
                                                         VerticalSpacing="15">
                                        <Button x:Uid="ClearButton"
                                                IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                                Click="{x:Bind ViewModel.ClearSelectedFilePath}">
                                            <Button.ContentTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon Glyph="&#xE894;"
                                                                  FontSize="16" />
                                                        <TextBlock Text="{x:Bind}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                        <TextBlock x:Uid="ViewSelectedFilesTextBlock"
                                                   TextWrapping="WrapWholeWords" />
                                        <TextBox Text="{x:Bind ViewModel.LocalPackageFilePath, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 IsSpellCheckEnabled="False"
                                                 MinWidth="400"
                                                 IsReadOnly="True" />
                                    </CCToolKit:WrapPanel>
                                </Flyout>
                            </customUI:ButtonV2.Flyout>
                        </customUI:ButtonV2>
                    </customUI:SettingsCardV3>
                    <customUI:SettingsCardV2 x:Uid="HardenedUpdateProcedureSettingsCard"
                                             IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
                        <customUI:SettingsCardV2.HeaderIcon>
                            <FontIcon Glyph="&#xF552;" />
                        </customUI:SettingsCardV2.HeaderIcon>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.UseHardenedInstallationProcess, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                      x:Uid="ToggleSwitchGeneral" />
                    </customUI:SettingsCardV2>
                </CCToolKit:SettingsExpander.Items>
            </CCToolKit:SettingsExpander>
            <!-- Package signature removal -->
            <CCToolKit:SettingsExpander IsExpanded="False"
                                        Header="Remove package signatures"
                                        Description="Create an unsigned copy, with optional removal of embedded package signatures."
                                        AutomationProperties.Name="Remove package signatures"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
                <CCToolKit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEB95;" />
                </CCToolKit:SettingsExpander.HeaderIcon>
                <CCToolKit:SettingsExpander.Content>
                    <CCToolKit:WrapPanel Orientation="Horizontal"
                                         HorizontalSpacing="8"
                                         VerticalSpacing="8">
                        <customUI:ButtonV2 x:Uid="FileBrowseButton"
                                           IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                           Click="{x:Bind ViewModel.BrowseForSignatureRemoval_Click}"
                                           Style="{StaticResource AccentButtonStyle}"
                                           ObservedData="{x:Bind ViewModel.PackageSignatureRemovalPath, Mode=OneWay}">
                            <customUI:ButtonV2.ContentTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xEC50;"
                                                  FontSize="16" />
                                        <TextBlock Text="{x:Bind}" />
                                    </StackPanel>
                                </DataTemplate>
                            </customUI:ButtonV2.ContentTemplate>
                            <customUI:ButtonV2.Flyout>
                                <Flyout>
                                    <CCToolKit:WrapPanel Orientation="Vertical"
                                                         HorizontalSpacing="15"
                                                         VerticalSpacing="15">
                                        <Button x:Uid="ClearButton"
                                                IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                                Click="{x:Bind ViewModel.Clear_PackageSignatureRemovalPath}">
                                            <Button.ContentTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <FontIcon Glyph="&#xE894;"
                                                                  FontSize="16" />
                                                        <TextBlock Text="{x:Bind}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                        <TextBlock x:Uid="ViewSelectedFilesTextBlock"
                                                   TextWrapping="WrapWholeWords" />
                                        <TextBox Text="{x:Bind ViewModel.PackageSignatureRemovalPath, Mode=OneWay}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 IsSpellCheckEnabled="False"
                                                 MinWidth="400"
                                                 IsReadOnly="True" />
                                    </CCToolKit:WrapPanel>
                                </Flyout>
                            </customUI:ButtonV2.Flyout>
                        </customUI:ButtonV2>
                        <Button Content="Save unsigned copy"
                                IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="{x:Bind ViewModel.RemovePackageSignature_Click}">
                            <Button.ContentTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <FontIcon Glyph="&#xE78C;"
                                                  FontSize="16" />
                                        <TextBlock Text="{x:Bind}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </CCToolKit:WrapPanel>
                </CCToolKit:SettingsExpander.Content>
                <CCToolKit:SettingsExpander.ItemsHeader>
                    <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.PackageSignatureRemovalInfoBar.IsOpen, Mode=TwoWay}"
                                        Message="{x:Bind ViewModel.PackageSignatureRemovalInfoBar.Message, Mode=OneWay}"
                                        Severity="{x:Bind ViewModel.PackageSignatureRemovalInfoBar.Severity, Mode=OneWay}"
                                        IsIconVisible="True"
                                        IsClosable="{x:Bind ViewModel.PackageSignatureRemovalInfoBar.IsClosable, Mode=OneWay}" />
                </CCToolKit:SettingsExpander.ItemsHeader>
                <CCToolKit:SettingsExpander.Items>
                    <CCToolKit:SettingsCard Header="Remove inner package signatures"
                                            Description="Off removes only the bundle signature. On also removes embedded payload-package signatures. Applies only to MSIXBundle files.">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.RemoveInnerPackageSignatures, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.SignatureSelectionIsBundle, Mode=OneWay}"
                                      x:Uid="ToggleSwitchGeneral"
                                      AutomationProperties.Name="Remove signatures from inner bundle packages" />
                    </CCToolKit:SettingsCard>
                </CCToolKit:SettingsExpander.Items>
            </CCToolKit:SettingsExpander>
            <!-- Package content explorer -->
            <CCToolKit:SettingsExpander IsExpanded="False"
                                        Header="Package explorer"
                                        Description="Read-only browsing of package contents, including files inside embedded packages."
                                        AutomationProperties.Name="Package explorer"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
                <CCToolKit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xECCD;" />
                </CCToolKit:SettingsExpander.HeaderIcon>
                <CCToolKit:SettingsExpander.Content>
                    <customUI:ButtonV2 x:Uid="FileBrowseButton"
                                       IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                       Click="{x:Bind ViewModel.BrowseForPackageExplorer_Click}"
                                       Style="{StaticResource AccentButtonStyle}"
                                       ObservedData="{x:Bind ViewModel.PackageExplorerPath, Mode=OneWay}">
                        <customUI:ButtonV2.ContentTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xEC50;"
                                              FontSize="16" />
                                    <TextBlock Text="{x:Bind}" />
                                </StackPanel>
                            </DataTemplate>
                        </customUI:ButtonV2.ContentTemplate>
                        <customUI:ButtonV2.Flyout>
                            <Flyout>
                                <CCToolKit:WrapPanel Orientation="Vertical"
                                                     HorizontalSpacing="15"
                                                     VerticalSpacing="15">
                                    <Button x:Uid="ClearButton"
                                            IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                            Click="{x:Bind ViewModel.ClearPackageExplorer_Click}">
                                        <Button.ContentTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <FontIcon Glyph="&#xE894;"
                                                              FontSize="16" />
                                                    <TextBlock Text="{x:Bind}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                    <TextBlock x:Uid="ViewSelectedFilesTextBlock"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBox Text="{x:Bind ViewModel.PackageExplorerPath, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsSpellCheckEnabled="False"
                                             MinWidth="400"
                                             IsReadOnly="True" />
                                </CCToolKit:WrapPanel>
                            </Flyout>
                        </customUI:ButtonV2.Flyout>
                    </customUI:ButtonV2>
                </CCToolKit:SettingsExpander.Content>
                <CCToolKit:SettingsExpander.ItemsHeader>
                    <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.PackageExplorerInfoBar.IsOpen, Mode=TwoWay}"
                                        Message="{x:Bind ViewModel.PackageExplorerInfoBar.Message, Mode=OneWay}"
                                        Severity="{x:Bind ViewModel.PackageExplorerInfoBar.Severity, Mode=OneWay}"
                                        IsClosable="{x:Bind ViewModel.PackageExplorerInfoBar.IsClosable, Mode=OneWay}" />
                </CCToolKit:SettingsExpander.ItemsHeader>
                <CCToolKit:SettingsExpander.Items>
                    <CCToolKit:SettingsCard ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Border Visibility="{x:Bind ViewModel.PackageEmptyStateVisibility(ViewModel.PackageExplorerItems.Count, ViewModel.ElementsAreEnabled), Mode=OneWay}"
                                    Padding="24,28"
                                    CornerRadius="12">
                                <StackPanel Spacing="12"
                                            HorizontalAlignment="Center"
                                            MaxWidth="440">
                                    <Border Width="64"
                                            Height="64"
                                            CornerRadius="16"
                                            HorizontalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xECCD;"
                                                  FontSize="28"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </Border>
                                    <TextBlock Text="Select a package to explore"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Choose an MSIX or MSIXBundle to browse its files, folders, and embedded packages."
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TreeView ItemsSource="{x:Bind ViewModel.PackageExplorerItems}"
                                      Visibility="{x:Bind ViewModel.PackageContentVisibility(ViewModel.PackageExplorerItems.Count), Mode=OneWay}"
                                      SelectionMode="Single"
                                      CanDragItems="False"
                                      CanReorderItems="False"
                                      IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                      MinHeight="200"
                                      MaxHeight="600"
                                      AutomationProperties.Name="Package contents">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="signing:PackageExplorerItem">
                                        <TreeViewItem ItemsSource="{x:Bind Children}"
                                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      AutomationProperties.Name="{x:Bind AccessibleName}"
                                                      ToolTipService.ToolTip="{x:Bind ToolTip}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8">
                                                <FontIcon Glyph="&#xE8A5;"
                                                          Foreground="#FFB279E6"
                                                          Visibility="{x:Bind PackageIconVisibility}"
                                                          FontSize="18"
                                                          Width="20"
                                                          Height="20"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />
                                                <FontIcon Glyph="&#xE8B7;"
                                                          Foreground="#FFE8B340"
                                                          Visibility="{x:Bind FolderIconVisibility}"
                                                          FontSize="18"
                                                          Width="20"
                                                          Height="20"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />
                                                <FontIcon Glyph="&#xE729;"
                                                          Visibility="{x:Bind FileIconVisibility}"
                                                          FontSize="18"
                                                          Width="20"
                                                          Height="20"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />
                                                <TextBlock Text="{x:Bind Name}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind SizeText}"
                                                           Visibility="{x:Bind SizeVisibility}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </CCToolKit:SettingsCard>
                </CCToolKit:SettingsExpander.Items>
            </CCToolKit:SettingsExpander>
            <!-- Package version editor -->
            <CCToolKit:SettingsExpander IsExpanded="False"
                                        Header="Package versions"
                                        Description="Edit one version at a time in the selected file. Each Save writes this selected file only after rebuilding and validation. Other inner packages and unsaved versions are not changed. The modified package is unsigned."
                                        AutomationProperties.Name="Package versions"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.PackageVersionItems}"
                                        IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}">
                <CCToolKit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xF466;" />
                </CCToolKit:SettingsExpander.HeaderIcon>
                <CCToolKit:SettingsExpander.Content>
                    <customUI:ButtonV2 x:Uid="FileBrowseButton"
                                       IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                       Click="{x:Bind ViewModel.BrowseForPackageVersions_Click}"
                                       Style="{StaticResource AccentButtonStyle}"
                                       ObservedData="{x:Bind ViewModel.PackageVersionPath, Mode=OneWay}">
                        <customUI:ButtonV2.ContentTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xEC50;"
                                              FontSize="16" />
                                    <TextBlock Text="{x:Bind}" />
                                </StackPanel>
                            </DataTemplate>
                        </customUI:ButtonV2.ContentTemplate>
                        <customUI:ButtonV2.Flyout>
                            <Flyout>
                                <CCToolKit:WrapPanel Orientation="Vertical"
                                                     HorizontalSpacing="15"
                                                     VerticalSpacing="15">
                                    <Button x:Uid="ClearButton"
                                            IsEnabled="{x:Bind ViewModel.ElementsAreEnabled, Mode=OneWay}"
                                            Click="{x:Bind ViewModel.ClearPackageVersions_Click}">
                                        <Button.ContentTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <FontIcon Glyph="&#xE894;"
                                                              FontSize="16" />
                                                    <TextBlock Text="{x:Bind}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                    <TextBlock x:Uid="ViewSelectedFilesTextBlock"
                                               TextWrapping="WrapWholeWords" />
                                    <TextBox Text="{x:Bind ViewModel.PackageVersionPath, Mode=OneWay}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsSpellCheckEnabled="False"
                                             MinWidth="400"
                                             IsReadOnly="True" />
                                </CCToolKit:WrapPanel>
                            </Flyout>
                        </customUI:ButtonV2.Flyout>
                    </customUI:ButtonV2>
                </CCToolKit:SettingsExpander.Content>
                <CCToolKit:SettingsExpander.ItemsHeader>
                    <StackPanel Spacing="8">
                        <customUI:InfoBarV2 IsOpen="{x:Bind ViewModel.PackageVersionInfoBar.IsOpen, Mode=TwoWay}"
                                            Message="{x:Bind ViewModel.PackageVersionInfoBar.Message, Mode=OneWay}"
                                            Severity="{x:Bind ViewModel.PackageVersionInfoBar.Severity, Mode=OneWay}"
                                            IsIconVisible="True"
                                            IsClosable="{x:Bind ViewModel.PackageVersionInfoBar.IsClosable, Mode=OneWay}" />
                        <Border Visibility="{x:Bind ViewModel.PackageEmptyStateVisibility(ViewModel.PackageVersionItems.Count, ViewModel.ElementsAreEnabled), Mode=OneWay}"
                                Padding="24,28"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12"
                                        HorizontalAlignment="Center"
                                        MaxWidth="440">
                                <Border Width="64"
                                        Height="64"
                                        CornerRadius="16"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xF466;"
                                              FontSize="28"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              IsHitTestVisible="False"
                                              AutomationProperties.AccessibilityView="Raw" />
                                </Border>
                                <TextBlock Text="Select a package to edit versions"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Choose an MSIX or MSIXBundle to load its versions."
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </CCToolKit:SettingsExpander.ItemsHeader>
                <CCToolKit:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="signing:PackageVersionItem">
                        <CCToolKit:SettingsCard Header="{x:Bind DisplayName}"
                                                HorizontalContentAlignment="Stretch">
                            <CCToolKit:WrapPanel Orientation="Horizontal"
                                                 HorizontalSpacing="8"
                                                 VerticalSpacing="8">
                                <TextBox Text="{x:Bind VersionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Major.Minor.Build.Revision"
                                         MaxLength="23"
                                         MinWidth="190"
                                         IsSpellCheckEnabled="False"
                                         AutomationProperties.Name="{x:Bind DisplayName}" />
                                <Button Content="Save"
                                        Click="{x:Bind Save_Click}"
                                        ToolTipService.ToolTip="Save only this version in the selected file after validation." />
                            </CCToolKit:WrapPanel>
                        </CCToolKit:SettingsCard>
                    </DataTemplate>
                </CCToolKit:SettingsExpander.ItemTemplate>
            </CCToolKit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
