<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HardenSystemSecurity.CustomUIElements.WindowsTopBar.TopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customUI="using:AppControlManager.CustomUIElements"
    xmlns:CC="using:CommonCore"
    xmlns:search="using:HardenSystemSecurity.CustomUIElements.WindowsTopBar"
    Title="Top Bar"
    xmlns:CCToolKit="using:CommonCore.ToolKits"
    Activated="{x:Bind OnWindowActivated}"
    Closed="{x:Bind OnWindowClosed}">

    <!-- The top bar is a border-less window docked opposite the taskbar on the display edge.
         When the Taskbar position is at the bottom, this bar is at the top of the screen. If Taskbar position is at the top, this bar is at the bottom of the screen.
         The window itself is resized on every animation frame and its silhouette is clipped by a rounded window
         region, so the visual tree below never needs to be re-laid out while the bar expands or retracts.
         The whole client area is painted with the color of the bar so that no lighter pixel of the window itself
         can ever show up along the edges that the region clips.
         In solid mode the client area is painted with the bar color; material modes use the Window backdrop
         behind the content instead. The window region remains the silhouette in every mode.
         The theme of the bar follows the app, and its brushes are updated when the effective theme changes. -->
    <Grid x:Name="RootGrid"
          Loaded="{x:Bind OnRootGridLoaded}"
          PointerEntered="{x:Bind OnRootPointerEntered}"
          PointerWheelChanged="{x:Bind OnViewSwitcherWheelChanged}"
          PointerExited="{x:Bind OnRootPointerExited}"
          PointerPressed="{x:Bind OnRootPointerPressed}"
          DragEnter="{x:Bind OnStorageDragEnter}"
          DragOver="{x:Bind OnStorageDragOver}"
          DragLeave="{x:Bind OnStorageDragLeave}"
          Drop="{x:Bind OnStorageDrop}">

        <!-- Only reason we use this is because of a bug in System composition engine not working with Window backdrops at the moment.
         Once that gets fixed, this should be removed. This extra element and the commented out line in code behind are the ONLY 2 things that are temporary and need to go after that bug gets fixed.-->
        <SystemBackdropElement x:Name="BackdropHost" IsHitTestVisible="False"/>

        <!-- The chrome of the bar. It carries no stroke at all and its corner radius is animated together with the window region.
             Only the two corners away from the docked display edge are rounded. -->
        <Border x:Name="BarBorder"
                BorderThickness="0"
                CornerRadius="0,0,17,17"/>

        <!-- The content that is visible while the bar is collapsed into the notch. -->
        <StackPanel x:Name="CollapsedHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="6"
                    IsHitTestVisible="False">
            <FontIcon x:Name="CollapsedGlyph"
                      Glyph="&#xEC50;"
                      FontSize="14"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <!-- This is the default notch content -->
            <TextBlock x:Name="CollapsedLabel"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <!-- Notch content specialized for an armed Sentry in spoken phrase mode. -->
            <TextBlock x:Name="CollapsedSentryPhraseText"
                       FontSize="12"
                       MaxWidth="160"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <!-- Notch content specialized for the Clocks view -->
            <StackPanel x:Name="CollapsedNotchClocksHost" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12"/>
            <!-- Notch content specialized for the Performance view -->
            <StackPanel x:Name="CollapsedPerformanceHost"
                        HorizontalAlignment="Center"
                        Width="153"
                        Spacing="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="CollapsedProcessName"
                           FontSize="10"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CollapsedProcessMetrics"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <!-- The content that is visible while the bar is expanded. Its width drives the expanded window width, so
             switching to a view whose content is wider or narrower animates the window to the new width. -->
        <StackPanel x:Name="ExpandedHost"
                    SizeChanged="{x:Bind OnExpandedHostSizeChanged}"
                    XYFocusKeyboardNavigation="Enabled"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Opacity="0"
                    IsHitTestVisible="False">

            <!-- Selects the active view. The views are offered as a vertical list of radio items,
                 so however many of them there are the bar always spends the very same width on the switcher.
                 The radio items share a single group, which is what keeps exactly one of the views selected at a time.
                 The menu is not constrained to the root bounds because the bar itself is only as tall as the notch. -->
            <Button x:Name="ViewSwitcherButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    MinWidth="0"
                    CornerRadius="14"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout x:Name="ViewSwitcherMenu"
                                Opened="{x:Bind OnFlyoutOpened}"
                                Closed="{x:Bind OnFlyoutClosed}"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False">
                        <RadioMenuFlyoutItem x:Name="AppsViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnAppsViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xECAA;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="FoldersViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnFoldersViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="WebsitesViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnWebsitesViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE774;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="PerformanceViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnPerformanceViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9D9;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="ClocksViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnClocksViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE823;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="NetworkQualityViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnNetworkQualityViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE968;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SentryViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnSentryViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE720;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem x:Name="SearchViewMenuItem"
                                             GroupName="TopBarViewSwitcher"
                                             Click="{x:Bind OnSearchViewButtonClick}">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE721;"/>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE8A9;"
                          FontSize="12"/>
            </Button>

            <!-- Animated companion. Replacing its content unloads the previous
                 self-contained animation control, which releases its render resources. -->
            <ContentControl x:Name="CompanionHost"
                            Width="72"
                            Height="64"
                            Padding="0"
                            Background="{x:Null}"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>

            <Border Width="1"
                    Height="56"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Only one of the views below is ever visible, and the visible one dictates the width of the bar.
                 The views are hosted inside a scroll viewer whose largest width is capped to whatever the display can
                 take, so a view that holds more entries than the display fits scrolls sideways instead of making the
                 bar grow past the edges of the display. -->
            <ScrollViewer x:Name="ViewsScrollViewer"
                          SizeChanged="{x:Bind UpdateScrollBarClearance}"
                          VerticalAlignment="Center"
                          HorizontalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          IsVerticalRailEnabled="False"
                          ZoomMode="Disabled">
                <Grid x:Name="ViewsHost"
                      VerticalAlignment="Center">

                    <!-- The application tiles are generated in the code behind from the entries of the bar. -->
                    <StackPanel x:Name="AppsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                XYFocusKeyboardNavigation="Enabled"
                                VerticalAlignment="Center"/>

                    <!-- The pinned folder tiles are generated in the code behind from the entries of the bar. -->
                    <StackPanel x:Name="FoldersPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                XYFocusKeyboardNavigation="Enabled"
                                Visibility="Collapsed"/>

                    <!-- Website tiles are created when the Websites view is first selected. -->
                    <StackPanel x:Name="WebsitesPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                XYFocusKeyboardNavigation="Enabled"
                                Visibility="Collapsed"/>

                    <!-- Every metric of the live system intelligence page, laid out over two compact rows. -->
                    <Grid x:Name="PerformancePanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          RowSpacing="3"
                          ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="CpuUsageCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="CpuUsageValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="CpuTemperatureCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="CpuTemperatureValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="MemoryCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="MemoryValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="3"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="StorageTemperatureCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="StorageTemperatureValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="4"
                                    MinWidth="118"
                                    Spacing="1">
                            <TextBlock x:Name="DiskActivityCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="DiskActivityValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="4"
                                    MinWidth="118"
                                    Spacing="1">
                            <TextBlock x:Name="NetworkCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="NetworkValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="SystemPowerCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="SystemPowerValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="BatteryDischargeCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="BatteryDischargeValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    MinWidth="86"
                                    Spacing="1">
                            <TextBlock x:Name="AppMemoryCaption"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="AppMemoryValue"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- The world clocks are generated in the code behind from the entries of the bar. -->
                    <StackPanel x:Name="ClocksPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                XYFocusKeyboardNavigation="Enabled"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Visibility="Collapsed"/>
                    <Grid x:Name="NetworkQualityPanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ColumnSpacing="8"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <ComboBox x:Name="NetworkQualityDestinationBox"
                                      Width="190"
                                      Height="32"
                                      IsEditable="True"
                                      PlaceholderText="IP address or domain"
                                      DropDownOpened="{x:Bind OnNetworkQualityDestinationDropDownOpened}"
                                      DropDownClosed="{x:Bind OnNetworkQualityDestinationDropDownClosed}">
                                <x:String>1.1.1.1</x:String>
                                <x:String>8.8.8.8</x:String>
                                <x:String>bing.com</x:String>
                                <x:String>google.com</x:String>
                                <x:String>x.com</x:String>
                            </ComboBox>
                            <TextBlock x:Name="NetworkQualityStatusText"
                                       FontSize="9"
                                       Text="Ready"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Grid Grid.Column="1"
                              RowSpacing="1"
                              ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NetworkQualityCurrentValue" Grid.Row="0" Grid.Column="0" FontSize="10" Text="Current: --"/>
                            <TextBlock x:Name="NetworkQualityAverageValue" Grid.Row="0" Grid.Column="1" FontSize="10" Text="Average: --"/>
                            <TextBlock x:Name="NetworkQualityJitterValue" Grid.Row="1" Grid.Column="0" FontSize="10" Text="Jitter: --"/>
                            <TextBlock x:Name="NetworkQualityLossValue" Grid.Row="1" Grid.Column="1" FontSize="10" Text="Loss: --"/>
                            <TextBlock x:Name="NetworkQualityLowValue" Grid.Row="2" Grid.Column="0" FontSize="10" Text="Low: --"/>
                            <TextBlock x:Name="NetworkQualityHighValue" Grid.Row="2" Grid.Column="1" FontSize="10" Text="High: --"/>
                        </Grid>
                        <StackPanel x:Name="NetworkQualityGraphPanel"
                                    Grid.Column="2"
                                    Height="48"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        <Button x:Name="NetworkQualityStartStopButton"
                                Grid.Column="3"
                                Content="Start"
                                Click="{x:Bind OnNetworkQualityStartStopButtonClick}"/>
                    </Grid>
                    <!-- The Acoustic Sentry. A decibel triggered environment audio recorder that arms in the
                         background and captures high fidelity WAV audio whenever the ambient level crosses the user defined trigger. -->
                    <Grid x:Name="SentryPanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ColumnSpacing="10"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Arm and disarm, plus a manual stop for the capture that is in flight. -->
                        <StackPanel Grid.Column="0"
                                    Spacing="3"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="SentryArmToggleButton"
                                          Width="86"
                                          Height="32"
                                          Padding="0"
                                          MinWidth="0"
                                          HorizontalAlignment="Center"
                                          Content="ARM"
                                          Click="{x:Bind OnSentryArmToggleClick}"/>
                            <Button x:Name="SentryStopButton"
                                    Width="86"
                                    Height="20"
                                    Padding="0"
                                    MinWidth="0"
                                    FontSize="11"
                                    IsEnabled="False"
                                    HorizontalAlignment="Center"
                                    Content="Stop"
                                    Click="{x:Bind OnSentryStopClick}"/>
                        </StackPanel>
                        <!-- The trigger mode. The decibel level and the spoken phrase controls are shown only for their own mode. -->
                        <StackPanel Grid.Column="1"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="MODE"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ComboBox x:Name="SentryModeBox"
                                      Width="128"
                                      FontSize="11"
                                      ToolTipService.ToolTip="Choose what starts a recording. Disarm before changing it."
                                      SelectionChanged="{x:Bind OnSentryModeChanged}">
                                <ComboBoxItem Content="Decibel level"/>
                                <ComboBoxItem Content="Spoken phrase"/>
                            </ComboBox>
                        </StackPanel>
                        <!-- The lightweight live audio graph. It scrolls the recent ambient level and only ticks
                             while the Sentry view is expanded and a session is armed. Bars turn red once their
                             level has crossed the trigger, so the trigger is read straight off the graph. -->
                        <StackPanel x:Name="SentryLevelPanel"
                                    Grid.Column="2"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="LIVE LEVEL"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <Border Width="156"
                                    Height="30"
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <StackPanel x:Name="SentryGraphPanel"
                                            Height="28"
                                            Orientation="Horizontal"
                                            Spacing="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,1"/>
                            </Border>
                            <TextBlock x:Name="SentryLevelText"
                                       FontSize="9"
                                       Text="-- dBFS"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- The phrase that triggers a recording in spoken phrase mode. -->
                        <StackPanel x:Name="SentryPhrasePanel"
                                    Grid.Column="3"
                                    Width="200"
                                    Visibility="Collapsed"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Spoken Phrase"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBox x:Name="SentryPhraseBox"
                                     MaxLength="160"
                                     PlaceholderText="Word(s) that start a recording"
                                     ToolTipService.ToolTip="The phrase is recognized on this device with the installed system speech language. Disarm before editing."
                                     TextChanged="{x:Bind OnSentryPhraseChanged}"/>
                            <TextBlock x:Name="SentryPhraseProgressText"
                                       FontSize="11"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Trigger sensitivity in dBFS. -->
                        <StackPanel x:Name="SentryTriggerPanel"
                                    Grid.Column="4"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="TRIGGER dBFS"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <Slider x:Name="SentryThresholdSlider"
                                    Width="150"
                                    Height="30"
                                    Minimum="-90"
                                    Maximum="0"
                                    StepFrequency="1"
                                    ValueChanged="{x:Bind OnSentryThresholdChanged}"/>
                            <TextBlock x:Name="SentryThresholdText"
                                       FontSize="9"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Capture length per trigger. -->
                        <StackPanel Grid.Column="5"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="REC SEC"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <NumberBox x:Name="SentryDurationBox"
                                       Minimum="1"
                                       Maximum="3600"
                                       SmallChange="5"
                                       LargeChange="30"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="{x:Bind OnSentryDurationChanged}"/>
                        </StackPanel>
                        <!-- Cooldown between captures. This is the timeout that governs how often a capture repeats. -->
                        <StackPanel Grid.Column="6"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="GAP SEC"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <NumberBox x:Name="SentryCooldownBox"
                                       Minimum="0"
                                       Maximum="3600"
                                       SmallChange="1"
                                       LargeChange="10"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="{x:Bind OnSentryCooldownChanged}"/>
                        </StackPanel>
                        <!-- How many capture cycles before the Sentry disarms itself. Zero means unlimited. -->
                        <StackPanel Grid.Column="7"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CYCLES 0=INF"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <NumberBox x:Name="SentryMaxCyclesBox"
                                       Minimum="0"
                                       Maximum="1000"
                                       SmallChange="1"
                                       LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="{x:Bind OnSentryMaxCyclesChanged}"/>
                        </StackPanel>
                        <!-- Where the captures are written. -->
                        <StackPanel Grid.Column="8"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="FOLDER"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="SentryFolderText"
                                       FontSize="9"
                                       MaxLines="1"
                                       MaxWidth="166"
                                       Text="Default folder"
                                       IsTextSelectionEnabled="True"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        Margin="0,4,0,0">
                                <Button FontSize="10"
                                        Content="Actions">
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="SentryActionsMenu"
                                                    Opened="{x:Bind OnSentryActionsMenuOpened}"
                                                    Closed="{x:Bind OnFlyoutClosed}"
                                                    Placement="Bottom"
                                                    ShouldConstrainToRootBounds="False">
                                            <MenuFlyoutItem Text="Browse"
                                                            Click="{x:Bind OnSentryBrowseClick}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE838;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Open"
                                                            Click="{x:Bind OnSentryOpenFolderClick}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8DA;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Reset"
                                                            Click="{x:Bind OnSentryDefaultFolderClick}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <RadioMenuFlyoutItem x:Name="SentryNoEncryptionMenuItem"
                                                                 Text="No encryption"
                                                                 GroupName="SentryEncryption"
                                                                 IsChecked="{x:Bind CC:Atlas.Settings.WindowsTopBarSentryNoEncryption, Mode=TwoWay}"
                                                                 Click="{x:Bind OnSentryEncryptionChanged}">
                                                <RadioMenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE785;"/>
                                                </RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                            <RadioMenuFlyoutItem x:Name="SentryEncryptUserMenuItem"
                                                                 Text="Encrypt recordings for current user"
                                                                 GroupName="SentryEncryption"
                                                                 IsChecked="{x:Bind CC:Atlas.Settings.WindowsTopBarSentryEncryptForUser, Mode=TwoWay}"
                                                                 Click="{x:Bind OnSentryEncryptionChanged}">
                                                <RadioMenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE77B;"/>
                                                </RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                            <RadioMenuFlyoutItem x:Name="SentryEncryptMachineMenuItem"
                                                                 Text="Encrypt recordings for this machine"
                                                                 GroupName="SentryEncryption"
                                                                 IsChecked="{x:Bind CC:Atlas.Settings.WindowsTopBarSentryEncryptForMachine, Mode=TwoWay}"
                                                                 Click="{x:Bind OnSentryEncryptionChanged}">
                                                <RadioMenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xF712;"/>
                                                </RadioMenuFlyoutItem.Icon>
                                            </RadioMenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <!-- Current state and completed cycle count. -->
                        <StackPanel Grid.Column="9"
                                    Spacing="1"
                                    Width="128"
                                    VerticalAlignment="Center">
                            <TextBlock Text="STATUS"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock x:Name="SentryStateText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="Idle"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <ScrollViewer MaxHeight="34"
                                          VerticalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SentryCyclesText"
                                           FontSize="9"
                                           TextWrapping="Wrap"
                                           Text="Cycles: 0"
                                           IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </ScrollViewer>
                            <HyperlinkButton x:Name="SentryOpenPrivacyButton"
                                             Padding="0"
                                             FontSize="10"
                                             Content="Open mic settings"
                                             Visibility="Collapsed"
                                             Click="{x:Bind OnSentryOpenPrivacyClick}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Global Search results arrive from the independent service pipe. -->
                    <Grid x:Name="SearchPanel"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <!-- Only the status trims on a narrow row; the result limit, the filters and the item count keep their full width. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- The result limit applies on Enter, when focus leaves the box, or with the arrows. Compact density keeps it as tall as the filters. -->
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <TextBlock FontSize="10"
                                               VerticalAlignment="Center"
                                               Text="Max results"/>
                                    <NumberBox x:Name="SearchLimitBox"
                                               Width="110"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Minimum="1"
                                               Maximum="10000"
                                               SmallChange="100"
                                               LargeChange="1000"
                                               SpinButtonPlacementMode="Compact"
                                               AutomationProperties.Name="Max results"
                                               ToolTipService.ToolTip="The most results to show, from 1 to 10,000. Higher numbers can take longer."
                                               ValueChanged="{x:Bind OnSearchLimitChanged}">
                                        <NumberBox.Resources>
                                            <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml"/>
                                        </NumberBox.Resources>
                                    </NumberBox>
                                </StackPanel>
                                <TextBlock x:Name="SearchStatusText"
                                           Grid.Column="1"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="Type to search"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Search filters. The kind is one choice. File types combine, and none selected includes every file.
                                     The last toggle only changes how the results are shown. -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                    <StackPanel.Resources>
                                        <Style TargetType="ToggleButton"
                                               BasedOn="{StaticResource DefaultToggleButtonStyle}">
                                            <Setter Property="Height" Value="24"/>
                                            <Setter Property="MinWidth" Value="0"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <ToggleButton x:Name="SearchAllToggle"
                                                  Content="All"
                                                  IsChecked="True"
                                                  ToolTipService.ToolTip="Files and folders"
                                                  Click="{x:Bind OnSearchKindClick}"/>
                                    <ToggleButton x:Name="SearchFilesToggle"
                                                  Content="Files"
                                                  ToolTipService.ToolTip="Files only"
                                                  Click="{x:Bind OnSearchKindClick}"/>
                                    <ToggleButton x:Name="SearchFoldersToggle"
                                                  Content="Folders"
                                                  ToolTipService.ToolTip="Folders only"
                                                  Click="{x:Bind OnSearchKindClick}"/>
                                    <Border Width="1"
                                            Height="16"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                    <ToggleButton x:Name="SearchPicturesToggle"
                                                  Content="Pictures"
                                                  ToolTipService.ToolTip="Pictures, such as JPG, PNG and HEIC"
                                                  Click="{x:Bind OnSearchTextChanged}"/>
                                    <ToggleButton x:Name="SearchVideosToggle"
                                                  Content="Videos"
                                                  ToolTipService.ToolTip="Videos, such as MP4, MKV and MOV"
                                                  Click="{x:Bind OnSearchTextChanged}"/>
                                    <ToggleButton x:Name="SearchAudioToggle"
                                                  Content="Audio"
                                                  ToolTipService.ToolTip="Audio, such as MP3, WAV and FLAC"
                                                  Click="{x:Bind OnSearchTextChanged}"/>
                                    <ToggleButton x:Name="SearchDocumentsToggle"
                                                  Content="Documents"
                                                  ToolTipService.ToolTip="Documents, such as PDF, Word, Excel and text files"
                                                  Click="{x:Bind OnSearchTextChanged}"/>
                                    <ToggleButton x:Name="SearchArchivesToggle"
                                                  Content="Archives"
                                                  ToolTipService.ToolTip="Archives, such as ZIP, 7Z and RAR"
                                                  Click="{x:Bind OnSearchTextChanged}"/>
                                    <Border Width="1"
                                            Height="16"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                    <ToggleButton x:Name="SearchLargeThumbnailsToggle"
                                                  AutomationProperties.Name="Large thumbnails"
                                                  ToolTipService.ToolTip="Show large thumbnails to preview pictures and videos"
                                                  Click="{x:Bind OnSearchLargeThumbnailsClick}">
                                        <FontIcon FontSize="12"
                                                  Glyph="&#xE8B9;"/>
                                    </ToggleButton>
                                </StackPanel>
                                <TextBlock x:Name="SearchIndexCountText"
                                           Grid.Column="3"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Text="Indexed items: --"/>
                            </Grid>
                            <TextBox x:Name="SearchTextBox"
                                     PlaceholderText="Search"
                                     TextChanged="{x:Bind OnSearchTextChanged}"/>
                            <ListView x:Name="SearchResultsListView"
                                      CanDragItems="{x:Bind CC:ViewModelBase.IsNotElevated}"
                                      DragItemsStarting="{x:Bind OnSearchDragItemsStarting}"
                                      Height="400"
                                      Padding="0"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ItemsSource="{x:Bind _searchResults, Mode=OneWay}">
                                <ListView.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.MergedDictionaries>
                                            <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml"/>
                                        </ResourceDictionary.MergedDictionaries>
                                        <!-- The two ways to show the same results. The code assigns one of them as the ItemTemplate.
                                             The width of the thumbnail column of each and the size of its Image must match the code. -->
                                        <DataTemplate x:Key="SearchCompactItemTemplate" x:DataType="search:TopBarSearchResult">
                                            <Grid Height="30"
                                                  Background="Transparent"
                                                  DoubleTapped="OnSearchResultDoubleTapped"
                                                  RightTapped="OnSearchResultRightTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[0].Width, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchPathWidth.Width, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[1].Width, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[2].Width, Mode=OneWay}"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0"
                                                       Width="20"
                                                       Height="20"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Stretch="Uniform"
                                                       Loaded="OnSearchThumbnailLoaded"
                                                       DataContextChanged="OnSearchThumbnailDataContextChanged"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Margin="8,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Path}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Size}" Margin="8,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="4" Text="{x:Bind DateModified}" Margin="8,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate x:Key="SearchLargeItemTemplate" x:DataType="search:TopBarSearchResult">
                                            <Grid Height="104"
                                                  Background="Transparent"
                                                  DoubleTapped="OnSearchResultDoubleTapped"
                                                  RightTapped="OnSearchResultRightTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[0].Width, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchPathWidth.Width, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[1].Width, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[2].Width, Mode=OneWay}"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0"
                                                       Width="96"
                                                       Height="96"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Stretch="Uniform"
                                                       Loaded="OnSearchThumbnailLoaded"
                                                       DataContextChanged="OnSearchThumbnailDataContextChanged"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Margin="8,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Path}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind Size}" Margin="8,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="4" Text="{x:Bind DateModified}" Margin="8,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ResourceDictionary>
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem"
                                           BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="5,0,0,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.Header>
                                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            Canvas.ZIndex="1"
                                            customUI:StickyHeaderBehaviorV2.IsEnabled="True">
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <!-- The code sets this to the thumbnail column width of the shown item template. -->
                                                <ColumnDefinition x:Name="SearchThumbnailHeaderColumn"
                                                                  Width="36"/>
                                                <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[0].Width, Mode=TwoWay}"/>
                                                <ColumnDefinition Width="{x:Bind search:TopBar.SearchPathWidth.Width, Mode=TwoWay}"/>
                                                <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[1].Width, Mode=TwoWay}"/>
                                                <ColumnDefinition Width="{x:Bind search:TopBar.SearchColumnManager.ColumnWidths[2].Width, Mode=TwoWay}"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Name" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" SizeChanged="{x:Bind OnSearchFixedColumnSizeChanged}"/>
                                            <TextBlock Grid.Column="2" Text="Path" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="Size" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" SizeChanged="{x:Bind OnSearchFixedColumnSizeChanged}"/>
                                            <!-- One Search-only resize handle; it does not resize the Size column. -->
                                            <Thumb Grid.Column="3"
                                               Width="8"
                                               Height="28"
                                               HorizontalAlignment="Left"
                                               Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                               DragDelta="{x:Bind OnSearchPathDragDelta}"/>
                                            <TextBlock Grid.Column="4" Text="Date modified" Margin="8,0" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" SizeChanged="{x:Bind OnSearchFixedColumnSizeChanged}"/>
                                        </Grid>
                                    </Border>
                                </ListView.Header>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border Width="1"
                    Height="56"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <CCToolKit:WrapPanel Orientation="Vertical"
                                 VerticalSpacing="6"
                                 VerticalAlignment="Center"
                                 HorizontalSpacing="6">

                <!-- Drive statistics are available only in Search. -->
                <Button x:Name="DriveStatisticsButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        MinWidth="0"
                        CornerRadius="14"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Drive file statistics"
                        AutomationProperties.Name="Drive file statistics"
                        Click="{x:Bind OnDriveStatisticsClick}">
                    <FontIcon Glyph="&#xE9D2;"
                              FontSize="12"/>
                </Button>
                <!-- Global Search settings, such as managing its indexes. Available only in Search. -->
                <Button x:Name="GlobalSearchSettingsButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        MinWidth="0"
                        CornerRadius="14"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Global Search Settings"
                        AutomationProperties.Name="Global Search Settings"
                        Click="{x:Bind OnGlobalSearchSettingsClick}">
                    <FontIcon Glyph="&#xE712;"
                              FontSize="12"/>
                </Button>
                <!-- Adds a new entry to the active view. It is hidden for the view that has nothing to add to. -->
                <Button x:Name="AddButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        MinWidth="0"
                        CornerRadius="14"
                        VerticalAlignment="Center"
                        Click="{x:Bind OnAddButtonClick}">
                    <FontIcon Glyph="&#xE710;"
                              FontSize="12"/>
                </Button>

                <!-- Carries every general option of the bar. The options are offered as a vertical list.
                 The menu is the one that stays open while the pointer is over it, which is what lets several options be
                 flipped in a row without the menu closing after each of them. -->
                <Button x:Name="SettingsButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        MinWidth="0"
                        CornerRadius="14"
                        VerticalAlignment="Center">
                    <Button.Flyout>
                        <customUI:MenuFlyoutV2 x:Name="SettingsMenu"
                                               Opened="{x:Bind OnFlyoutOpened}"
                                               Closed="{x:Bind OnFlyoutClosed}"
                                               Placement="Bottom"
                                               ShouldConstrainToRootBounds="False">
                            <ToggleMenuFlyoutItem x:Name="NotchStyleMenuItem"
                                                  Click="{x:Bind OnNotchStyleToggleClick}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE73F;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="OpenOnHoverMenuItem"
                                                  IsChecked="{x:Bind CC:Atlas.Settings.WindowsTopBarOpenOnHover, Mode=TwoWay}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE962;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="AlwaysOnTopMenuItem"
                                                  Click="{x:Bind OnAlwaysOnTopMenuItemClick}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE840;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="AutoHideFullScreenMenuItem"
                                                  IsChecked="{x:Bind CC:Atlas.Settings.WindowsTopBarAutoHideInFullScreen, Mode=TwoWay}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="PinMenuItem"
                                                  Click="{x:Bind OnPinToggleClick}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="SystemCompositionMenuItem"
                                                  Text="Use system composition (next launch)"
                                                  ToolTipService.ToolTip="This will only take effect on the next launch of TopBar. It will make the TopBar use less RAM."
                                                  Loaded="{x:Bind OnSystemCompositionLoaded}"
                                                  Click="{x:Bind OnSystemCompositionToggleClick}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF120;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSubItem Text="Background">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE790;"/>
                                </MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem x:Name="SolidBackdropMenuItem"
                                                     Text="Solid"
                                                     GroupName="TopBarBackdrop"
                                                     Click="{x:Bind OnSolidBackdropClick}"/>
                                <RadioMenuFlyoutItem x:Name="MicaBackdropMenuItem"
                                                     Text="Mica"
                                                     GroupName="TopBarBackdrop"
                                                     Click="{x:Bind OnMicaBackdropClick}"/>
                                <RadioMenuFlyoutItem x:Name="MicaAltBackdropMenuItem"
                                                     Text="Mica Alt"
                                                     GroupName="TopBarBackdrop"
                                                     Click="{x:Bind OnMicaAltBackdropClick}"/>
                                <RadioMenuFlyoutItem x:Name="AcrylicBackdropMenuItem"
                                                     Text="Acrylic"
                                                     GroupName="TopBarBackdrop"
                                                     Click="{x:Bind OnAcrylicBackdropClick}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="CompanionMenuItem">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xEA86;"/>
                                </MenuFlyoutSubItem.Icon>
                                <RadioMenuFlyoutItem x:Name="NoCompanionMenuItem"
                                                     GroupName="TopBarCompanion"
                                                     Click="{x:Bind OnNoCompanionClick}"/>
                                <RadioMenuFlyoutItem x:Name="PrisMatrixCompanionMenuItem"
                                                     GroupName="TopBarCompanion"
                                                     Click="{x:Bind OnPrisMatrixCompanionClick}"/>
                                <RadioMenuFlyoutItem x:Name="NullCatCompanionMenuItem"
                                                     GroupName="TopBarCompanion"
                                                     Click="{x:Bind OnNullCatCompanionClick}"/>
                                <RadioMenuFlyoutItem x:Name="BunnyCompanionMenuItem"
                                                     GroupName="TopBarCompanion"
                                                     Click="{x:Bind OnBunnyCompanionClick}"/>
                                <RadioMenuFlyoutItem x:Name="SquirrelCompanionMenuItem"
                                                     GroupName="TopBarCompanion"
                                                     Click="{x:Bind OnSquirrelCompanionClick}"/>
                                <RadioMenuFlyoutItem x:Name="PopForgeCompanionMenuItem"
                                                     GroupName="TopBarCompanion"
                                                     Click="{x:Bind OnPopForgeCompanionClick}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator/>
                            <ToggleMenuFlyoutItem x:Name="StartupMenuItem"
                                                  Click="{x:Bind OnStartupToggleClick}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <!-- Enables or disables the Global Search startup task, which is disabled by default. -->
                            <ToggleMenuFlyoutItem x:Name="SearchIndexAtStartupToggle"
                                                  Text="Index at Windows startup"
                                                  IsEnabled="False"
                                                  Loaded="{x:Bind OnSearchStartupLoaded}"
                                                  Click="{x:Bind OnSearchStartupToggled}">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF71C;"/>
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </customUI:MenuFlyoutV2>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE713;"
                              FontSize="12"/>
                </Button>

                <Button x:Name="CloseButton"
                        Width="28"
                        Height="28"
                        Padding="0"
                        MinWidth="0"
                        CornerRadius="14"
                        VerticalAlignment="Center"
                        Click="{x:Bind OnCloseButtonClick}">
                    <FontIcon Glyph="&#xE711;"
                              FontSize="12"/>
                </Button>

            </CCToolKit:WrapPanel>

        </StackPanel>
    </Grid>
</Window>
